<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Title>OnixLabs.Security.Cryptography</Title>
        <Description>ONIXLabs Cryptography API for .NET</Description>
        <IsPackable>true</IsPackable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\OnixLabs.Core\OnixLabs.Core.csproj"/>
        <InternalsVisibleTo Include="OnixLabs.Security.Cryptography.UnitTests"/>
        <Using Include="OnixLabs.Core.Preconditions" Static="True"/>
    </ItemGroup>
    <!-- Why: Pkcs8PrivateKeyInfo is not in the shared framework on any target, so each target takes the package from its own runtime's servicing line. -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
        <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2"/>
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
        <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.23"/>
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15"/>
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
        <PackageReference Include="System.Security.Cryptography.Pkcs" Version="11.0.0"/>
    </ItemGroup>
</Project>
